---
import I18nText from '../components/I18nText.astro';
import PageHero from '../components/PageHero.astro';
import { getPageSettings, getPublishedThoughts } from '../lib/content';
import { formatLocalizedDate, localizeThoughtLabel } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
const [thoughts, pages] = await Promise.all([getPublishedThoughts(), getPageSettings()]);
const categoryCount = new Set(thoughts.map((post) => post.data.category).filter(Boolean)).size;
const tagCount = new Set(thoughts.flatMap((post) => post.data.tags ?? [])).size;
const thoughtsPage = pages.thoughts;
---
<BaseLayout
  title={thoughtsPage.navLabel}
  titleEn={thoughtsPage.navLabelEn ?? thoughtsPage.navLabel}
  description="Robin Lu 的想法与文章"
  descriptionEn="Thoughts and writing from Robin Lu"
  activePage="thoughts"
>
  <div class="thoughts-layout">
    <div class="thoughts-main">
      <PageHero
        variant="thoughts"
        sectionNumber={thoughtsPage.sectionNumber}
        title={thoughtsPage.navLabel}
        titleEn={thoughtsPage.navLabelEn}
        intro={thoughtsPage.intro}
        introEn={thoughtsPage.introEn}
      />

      <div class="thoughts-content">
        {thoughts.length > 0 ? (
          <div class="post-list">
            {thoughts.map((post) => {
              const dateCopy = formatLocalizedDate(post.data.date);
              const hasEnglishVersion = Boolean(post.data.titleEn?.trim() && post.data.bodyEn?.trim());
              const titleEn = hasEnglishVersion ? post.data.titleEn ?? post.data.title : post.data.title;
              const descriptionEn = hasEnglishVersion ? post.data.descriptionEn ?? post.data.description : post.data.description;
              const categoryCopy = localizeThoughtLabel(post.data.category);
              const tagCopies = (post.data.tags ?? []).slice(0, 2).map((tag) => localizeThoughtLabel(tag));

              return (
                <a href={`/thoughts/${post.id}`} class="post-item" style="display:block">
                  <div class="post-item-meta">
                    <span class="post-date"><I18nText zh={dateCopy.zh} en={dateCopy.en} /></span>
                    {categoryCopy && (
                      <span class="post-category">
                        <I18nText zh={categoryCopy.zh} en={categoryCopy.en} />
                      </span>
                    )}
                    {tagCopies.map((tagCopy) => tagCopy && (
                      <span class="tag">
                        <I18nText zh={tagCopy.zh} en={tagCopy.en} />
                      </span>
                    ))}
                  </div>
                  <h3><I18nText zh={post.data.title} en={titleEn} /></h3>
                  {post.data.description && descriptionEn && <p><I18nText zh={post.data.description} en={descriptionEn} /></p>}
                  <div class="post-item-footer">
                    <span class="post-read-time"><I18nText zh={`${post.data.readTime} 分钟阅读`} en={`${post.data.readTime} min read`} /></span>
                    <span class="post-arrow">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="quote-block" style="margin:32px 64px;">
            <p class="quote-text"><I18nText zh="当前还没有文章内容。" en="No posts yet." /></p>
          </div>
        )}
      </div>
    </div>

    <aside class="thoughts-sidebar">
      <div class="sidebar-widget">
        <div class="widget-title"><I18nText zh="统计" en="Stats" /></div>
        <div class="topic-list">
          <div class="topic-item"><I18nText zh="文章" en="Posts" /><span class="topic-count">{thoughts.length}</span></div>
          {categoryCount > 0 && (
            <div class="topic-item"><I18nText zh="分类" en="Categories" /><span class="topic-count">{categoryCount}</span></div>
          )}
          {tagCount > 0 && (
            <div class="topic-item"><I18nText zh="标签" en="Tags" /><span class="topic-count">{tagCount}</span></div>
          )}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

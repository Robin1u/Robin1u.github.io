---
import I18nText from '../components/I18nText.astro';
import PageHero from '../components/PageHero.astro';
import RecentTimeline from '../components/RecentTimeline.astro';
import { getHomeSettings, getLifeEntries, getPageSettings, sortRecentItems } from '../lib/content';
import { formatLocalizedDate } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const [site, pages, sortedPhotos] = await Promise.all([
  getHomeSettings(),
  getPageSettings(),
  getLifeEntries(),
]);
const lifePage = pages.life;
const timelineItems = sortRecentItems(site.recentItems);
---
<BaseLayout
  title={lifePage.navLabel}
  titleEn={lifePage.navLabelEn ?? lifePage.navLabel}
  description="Robin Lu 的生活照片与日常痕迹"
  descriptionEn="Life photos and everyday traces from Robin Lu"
  activePage="life"
>
  <div class="thoughts-layout life-page-layout">
    <div class="thoughts-main">
      <PageHero
        variant="thoughts"
        sectionNumber={lifePage.sectionNumber}
        title={lifePage.navLabel}
        titleEn={lifePage.navLabelEn}
        intro={lifePage.intro}
        introEn={lifePage.introEn}
      />

      <section class="life-mobile-recent">
        <div class="sidebar-widget">
          <div class="widget-title"><I18nText zh={site.recentTitle ?? '最近在做'} en={site.recentTitleEn ?? site.recentTitle ?? 'Recently Doing'} /></div>
          <div class="life-mobile-recent-scroll">
            <RecentTimeline items={timelineItems} emptyClass="flush-quote" />
          </div>
        </div>
      </section>

      {sortedPhotos.length > 0 ? (
        <div class="life-feed">
          {sortedPhotos.map((photo) => {
            const titleEn = photo.data.titleEn ?? photo.data.title;
            const captionEn = photo.data.captionEn ?? photo.data.caption;
            const dateCopy = formatLocalizedDate(photo.data.date);

            return (
              <article class="life-story-card">
                <div class="life-story-image">
                  <img
                    src={photo.data.image}
                    alt={photo.data.title}
                    data-i18n-alt-zh={photo.data.title}
                    data-i18n-alt-en={titleEn}
                    loading="lazy"
                  />
                </div>
                <div class="life-story-body">
                  <time class="life-story-date"><I18nText zh={dateCopy.zh} en={dateCopy.en} /></time>
                  {photo.data.location && (
                    <div class="life-story-location">
                      <I18nText zh={photo.data.location} en={photo.data.locationEn ?? photo.data.location} />
                    </div>
                  )}
                  <h2 class="life-story-title"><I18nText zh={photo.data.title} en={titleEn} /></h2>
                  {photo.data.caption && (
                    <p class="life-story-caption"><I18nText zh={photo.data.caption} en={captionEn ?? photo.data.caption} /></p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="quote-block" style="margin:32px 64px;">
          <p class="quote-text"><I18nText zh="当前还没有生活照片内容。" en="No life photo posts yet." /></p>
        </div>
      )}
    </div>

    <aside class="thoughts-sidebar">
      <div class="sidebar-widget">
        <div class="widget-title"><I18nText zh={site.recentTitle ?? '最近在做'} en={site.recentTitleEn ?? site.recentTitle ?? 'Recently Doing'} /></div>
        <RecentTimeline items={timelineItems} emptyClass="flush-quote" />
      </div>
    </aside>
  </div>

  <style is:global>
    .life-page-layout,
    .life-page-layout .thoughts-main {
      min-width: 0;
    }

    .life-mobile-recent {
      display: none;
      padding: 24px 64px 0;
      overflow: hidden;
    }

    .life-mobile-recent .sidebar-widget {
      overflow: hidden;
    }

    .life-mobile-recent-scroll {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      margin-top: 14px;
    }

    .life-feed {
      padding: 40px 64px 72px;
      display: grid;
      gap: 24px;
      min-width: 0;
    }

    .life-story-card {
      display: grid;
      grid-template-columns: minmax(260px, 0.9fr) minmax(260px, 0.7fr);
      align-items: stretch;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--color-surface);
    }

    .life-story-image {
      min-height: 320px;
      max-height: 460px;
      background: var(--color-surface-2);
      overflow: hidden;
    }

    .life-story-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .life-story-body {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 28px;
    }

    .life-story-date {
      display: block;
      font-size: 12px;
      color: var(--color-text-subtle);
      margin-bottom: 6px;
    }

    .life-story-location {
      font-size: 12px;
      color: var(--color-text-muted);
      margin-bottom: 12px;
    }

    .life-story-title {
      margin: 0;
      font-size: clamp(22px, 2vw, 30px);
      color: var(--color-white);
      letter-spacing: -0.03em;
    }

    .life-story-caption {
      margin: 12px 0 0;
      color: var(--color-text-muted);
      font-size: 15px;
      line-height: 1.8;
    }

    .life-timeline-list {
      display: grid;
      gap: 14px;
      margin-top: 14px;
    }

    .life-timeline-item {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
      padding: 16px;
    }

    .life-timeline-item.done {
      opacity: 0.78;
    }

    .life-timeline-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      margin-bottom: 10px;
    }

    .life-timeline-category,
    .life-timeline-week,
    .life-timeline-state {
      font-size: 12px;
      color: var(--color-text-muted);
    }

    .life-timeline-week {
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .life-timeline-title {
      margin: 0;
      font-size: 24px;
      color: var(--color-white);
    }

    .life-timeline-subtitle {
      margin: 8px 0 0;
      color: var(--color-text-muted);
      font-size: 14px;
      line-height: 1.65;
    }

    .life-timeline-state {
      margin-top: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .life-timeline-state.active {
      color: #7be495;
    }

    .life-timeline-state.done {
      color: var(--color-text-muted);
    }

    .life-timeline-state-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #7be495;
      box-shadow: 0 0 0 4px rgba(123, 228, 149, 0.08);
    }

    .life-timeline-state.done .life-timeline-state-dot {
      background: #121212;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    .thoughts-sidebar .life-timeline-list {
      position: relative;
      gap: 0;
      padding-left: 18px;
    }

    .thoughts-sidebar .life-timeline-list::before {
      content: "";
      position: absolute;
      left: 4px;
      top: 8px;
      bottom: 12px;
      width: 1px;
      background: linear-gradient(
        to bottom,
        rgba(232, 213, 163, 0.5),
        rgba(255, 255, 255, 0.07)
      );
    }

    .thoughts-sidebar .life-timeline-item {
      position: relative;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0 0 24px 18px;
    }

    .thoughts-sidebar .life-timeline-item::before {
      content: "";
      position: absolute;
      left: -17px;
      top: 5px;
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: #7be495;
      box-shadow: 0 0 0 4px rgba(123, 228, 149, 0.08);
    }

    .thoughts-sidebar .life-timeline-item.done::before {
      background: #151515;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    }

    .thoughts-sidebar .life-timeline-top {
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .thoughts-sidebar .life-timeline-title {
      font-size: 16px;
      line-height: 1.35;
    }

    .thoughts-sidebar .life-timeline-subtitle {
      font-size: 13px;
      line-height: 1.55;
    }

    .thoughts-sidebar .life-timeline-state {
      margin-top: 10px;
      font-size: 11px;
    }

    @media (max-width: 1024px) {
      .life-mobile-recent {
        display: block;
      }
    }

    @media (max-width: 768px) {
      .life-mobile-recent {
        padding: 24px 20px 0;
      }

      .life-mobile-recent-scroll {
        margin-right: -20px;
        padding-right: 20px;
      }

      .life-mobile-recent .life-timeline-list {
        display: flex;
        gap: 12px;
        width: max-content;
        min-width: 100%;
        padding-bottom: 8px;
        margin-top: 0;
        scroll-snap-type: x proximity;
      }

      .life-mobile-recent .life-timeline-item {
        flex: 0 0 min(82vw, 280px);
        scroll-snap-align: start;
      }

      .life-mobile-recent .life-timeline-title {
        font-size: 20px;
        line-height: 1.2;
      }

      .life-mobile-recent .life-timeline-subtitle {
        font-size: 13px;
      }

      .life-feed {
        padding: 24px 20px 40px;
        overflow-x: hidden;
      }

      .life-story-card {
        display: block;
      }

      .life-story-image {
        aspect-ratio: 4 / 3;
        min-height: 0;
        max-height: none;
      }

      .life-story-body {
        display: block;
        padding: 18px 20px 20px;
      }

      .life-story-title {
        font-size: clamp(24px, 7vw, 30px);
      }
    }
  </style>
</BaseLayout>

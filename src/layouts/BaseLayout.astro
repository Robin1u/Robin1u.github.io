---
import MobileHeader from '../components/MobileHeader.astro';
import SiteSidebar, { type ActivePage } from '../components/SiteSidebar.astro';
import { getHomeSettings, getPageSettings } from '../lib/content';
import '../styles/global.css';

export interface Props {
  title: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  activePage?: ActivePage;
}

const {
  title,
  titleEn = title,
  description = '个人主页',
  descriptionEn = 'Personal website',
  activePage = 'home',
} = Astro.props;

const pageTitleZh = `${title} · Robin Lu`;
const pageTitleEn = `${titleEn} · Robin Lu`;
const [siteSettings, pageSettings] = await Promise.all([
  getHomeSettings(),
  getPageSettings(),
]);
---
<!DOCTYPE html>
<html lang="zh-CN" data-language="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="metaDescription" name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{pageTitleZh}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('site-language');
          if (saved === 'zh' || saved === 'en') {
            document.documentElement.dataset.language = saved;
            document.documentElement.lang = saved === 'en' ? 'en' : 'zh-CN';
          }
        } catch {
        }
      })();
    </script>
  </head>
  <body
    data-page-title-zh={pageTitleZh}
    data-page-title-en={pageTitleEn}
    data-page-description-zh={description}
    data-page-description-en={descriptionEn}
  >
    <div class="scroll-progress" id="scrollProgress"></div>
    <MobileHeader name={siteSettings.name} nameEn={siteSettings.nameEn} />
    <div class="overlay" id="overlay"></div>

    <div class="layout">
      <SiteSidebar activePage={activePage} site={siteSettings} pages={pageSettings} />
      <main class="main-content" role="main">
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
